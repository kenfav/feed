import requests
import datetime
from feedgen.feed import FeedGenerator

def gerar_feed_video():
    # URL da API
    url = "https://b.jw-cdn.org/apis/mediator/v1/categories/E/LatestVideos?detailed=1&mediaLimit=0&clientType=json"
    
    print(f"Baixando dados: {url}")
    
    try:
        r = requests.get(url, timeout=30)
        r.raise_for_status()
        data = r.json()
    except Exception as e:
        print(f"Erro: {e}")
        return

    fg = FeedGenerator()
    fg.title(data['category']['name'])
    fg.description('Latest videos from JW Broadcasting')
    fg.link(href='https://www.jw.org', rel='alternate')
    fg.language('en')

    videos = data['category'].get('media', [])
    print(f"Gerando feed para {len(videos)} vídeos...")

    for video in videos:
        fe = fg.add_entry()
        fe.title(video['title'])
        
        # 1. Encontra o Link do Vídeo (720p ou Melhor disponível)
        files = video.get('files', [])
        video_url = ""
        file_size = 0
        
        for f in files:
            if f.get('label') == '720p':
                video_url = f.get('progressiveDownloadURL')
                file_size = f.get('filesize', 0)
                break
        
        if not video_url and files:
            video_url = files[-1].get('progressiveDownloadURL')
            file_size = files[-1].get('filesize', 0)

        # 2. Imagem de Capa
        images = video.get('images', {})
        img_src = ""
        if 'wss' in images and 'lg' in images['wss']:
            img_src = images['wss']['lg']
        elif 'sqr' in images and 'md' in images['sqr']:
            img_src = images['sqr']['md']

        # 3. Configurações de Link e Enclosure
        if video_url:
            fe.link(href=video_url) # Clicar no título abre o vídeo
            fe.id(video_url)
            fe.enclosure(video_url, str(file_size), 'video/mp4')

        if 'firstPublished' in video:
            fe.published(video['firstPublished'])

        # 4. CONSTRUÇÃO DO HTML (A parte importante)
        duration = video.get('durationFormattedMinSec', '')
        desc_text = video.get('description', '')

        content = ""

        # ESTRATÉGIA HÍBRIDA:
        if video_url:
            # A) Player de Vídeo HTML5 (Para leitores modernos/Web)
            # preload="none" é importante para não travar o app carregando 20 vídeos ao mesmo tempo
            content += f'''
            <div style="margin-bottom: 15px;">
                <video controls preload="none" poster="{img_src}" style="width:100%; max-width:100%; border-radius: 8px; background-color: #000;">
                    <source src="{video_url}" type="video/mp4">
                </video>
            </div>
            '''
            
            # B) Imagem Clicável (Fallback para Apps que removem a tag <video>)
            # Se o vídeo acima sumir, isso aqui garante que você consiga assistir
            content += f'''
            <div style="margin-bottom: 10px; font-size: 0.9em; color: #555;">
                Caso o player não carregue:
                <br>
                <a href="{video_url}" target="_blank" style="text-decoration: none; font-weight: bold; color: #3b5998;">
                    ▶️ Assistir Vídeo ({duration})
                </a>
            </div>
            '''
        elif img_src:
            content += f'<img src="{img_src}" style="width:100%; max-width:600px;" /><br>'
        
        if desc_text:
            content += f'<p>{desc_text}</p>'

        fe.content(content, type='CDATA')
        fe.description(desc_text if desc_text else video['title'])

    # Salva formatado
    fg.rss_file('feed_video.xml', pretty=True)
    print("Concluído!")

if __name__ == "__main__":
    gerar_feed_video()
